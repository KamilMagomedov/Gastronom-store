APP_NAME=Laravel
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://home-delivery-app-back.test/

LOG_CHANNEL=stack
LOG_LEVEL=warning

APP_LOCALE=ru

# ======================
# DATABASE (TESTING)
# ======================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=project_db_testing
DB_USERNAME=root
DB_PASSWORD=

# ======================
# CACHE / SESSION
# ======================
CACHE_DRIVER=array
SESSION_DRIVER=array
SESSION_LIFETIME=120

# ======================
# QUEUE
# ======================
QUEUE_CONNECTION=sync

# ======================
# BROADCAST / EVENTS
# ======================
BROADCAST_CONNECTION=log

# ======================
# FILES
# ======================
FILESYSTEM_DISK=local

# ======================
# MAIL
# ======================
MAIL_MAILER=array
MAIL_FROM_ADDRESS=test@example.com
MAIL_FROM_NAME="Laravel Testing"

# ======================
# REDIS (OFF)
# ======================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ======================
# HASHING (FASTER TESTS)
# ======================
BCRYPT_ROUNDS=4

# ======================
# TELESCOPE / DEBUG
# ======================
TELESCOPE_ENABLED=false
